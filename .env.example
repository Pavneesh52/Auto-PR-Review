# ── GitHub ─────────────────────────────────────────────────────────────
# Webhook HMAC verification (required)
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# GitHub App (optional — for authenticated API access)
GITHUB_APP_ID=0
GITHUB_PRIVATE_KEY_PATH=

# GitHub PAT for posting review comments (Phase 13)
GITHUB_TOKEN=ghp_your-personal-access-token

# ── Redis ──────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Database ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://pr_agent:pr_agent_secret@localhost:5433/pr_review_agent
DATABASE_URL_SYNC=postgresql://pr_agent:pr_agent_secret@localhost:5433/pr_review_agent

# ── LLM (Phases 6-9) ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# ── Embeddings (Phase 10) ─────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ── Review Limits ──────────────────────────────────────────────────────
MAX_COMMENTS_PER_PR=10
CONTEXT_FILE_LIMIT=20
LARGE_PR_THRESHOLD=500

# ── GitHub Posting (Phase 13) ──────────────────────────────────────────
GITHUB_COMMENT_MODE=summary  # summary | inline | both

# ── Rate Limiting (Phase 17) ───────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_REPO_PER_HOUR=10
MAX_COST_PER_REVIEW_USD=0.50
MAX_TOKENS_PER_REVIEW=50000
MAX_TOKENS_PER_REPO_PER_DAY=500000

# ── HITL (Phase 12) ────────────────────────────────────────────────────
# Findings below this confidence pause the review for human approval.
HITL_CONFIDENCE_THRESHOLD=0.7

# ── LLM pricing (USD per 1M tokens, used for cost tracking) ────────────
LLM_PRICE_PER_1M_INPUT_TOKENS=0.15
LLM_PRICE_PER_1M_OUTPUT_TOKENS=0.60

# ── Semantic search (Phase 10) ─────────────────────────────────────────
SEMANTIC_SEARCH_ENABLED=true
SEMANTIC_SEARCH_LIMIT=5

# ── App ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
DEBUG=false
