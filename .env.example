# AI PR Review Agent - Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME="AI PR Review Agent"
DEBUG=true
ENVIRONMENT=development

# Tiger Cloud Database (PostgreSQL compatible with TimescaleDB, pgvector, pgvectorscale)
TIGER_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB?sslmode=require

# NVIDIA API Key (for Nemotron 3 Ultra LLM only)
# Get from https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-...

# GitHub App Configuration
# Create a GitHub App at https://github.com/settings/apps
GITHUB_APP_ID=123456
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
GITHUB_PRIVATE_KEY_PATH=./github-app-private-key.pem

# Redis (for ARQ job queue)
REDIS_URL=redis://localhost:6379/0

# Model Configuration
NVIDIA_MODEL=nvidia/nemotron-3-ultra
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Local Embeddings (FREE - sentence-transformers)
# Runs locally on CPU/GPU, no API key needed
# Models: all-MiniLM-L6-v2 (384d, fast), all-mpnet-base-v2 (768d, better quality)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_DEVICE=cpu  # or cuda if GPU available

# Budget & Limits
DAILY_TOKEN_BUDGET=1000000
DAILY_COST_BUDGET_USD=50.0
CONFIDENCE_THRESHOLD=0.75
MAX_CONCURRENT_REVIEWS=10
REVIEW_TIMEOUT_SECONDS=300